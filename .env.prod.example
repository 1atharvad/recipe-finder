# Copy to .env next to docker-compose.yml on the VPS, fill in real values, then
# run `docker compose up -d --build`. Not the same as the root .env.example,
# which is for local dev via `npm run dev` — this is prod-only.

# Your PROD Supabase project's connection details (separate project from dev).
SPRING_DATASOURCE_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# HMAC-SHA key for JWT signing. Generate a random one, e.g. `openssl rand -hex 32`
# — use a different value than your dev .env.
JWT_SECRET=

# Admin panel login (/admin/login) — not a real user account. Use different
# credentials than your dev .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated CORS-allowed origins — your prod frontend's URL(s).
ALLOWED_ORIGINS=https://cookmate-recipes.vercel.app

# Google Gemini API key — powers recipe embeddings + smart search + the chat
# assistant. Required to start (no fallback), even if you don't use these features.
GEMINI_API_KEY=
