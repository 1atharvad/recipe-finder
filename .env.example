# Copy to .env — `npm run dev:backend` loads this via dotenv-cli before
# starting the backend with `mvn spring-boot:run`.
#
# JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD, and GEMINI_API_KEY have no
# fallback default (dev included) — the backend won't start unless they're
# all set. The SPRING_DATASOURCE_* vars below do have a fallback (a local
# Postgres on localhost), but you still need to set them for a real Supabase
# dev database.

# Connection details for a Supabase Postgres project used as the dev
# database. Create a free project at https://supabase.com, enable the
# "vector" extension under Database > Extensions, then grab these from
# Project Settings > Database > Connection string (use the "Session pooler"
# or direct connection — either works for local dev). Supabase requires SSL,
# so the URL must include ?sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# HMAC-SHA key for JWT signing. Generate a random one, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Admin panel login (/admin/login) — not a real user account, just a fixed
# credential pair checked against these values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google Gemini API key — powers recipe embeddings + smart search + the chat assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
