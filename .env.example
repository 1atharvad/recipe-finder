# Copy to .env (same directory as docker-compose.dev.yml) — `docker compose`
# auto-loads it, so `npm run dev` / `npm run dev:backend` will pick this up.
#
# Everything here is optional for local dev; the backend runs fine without it,
# just with smart search / the recipe assistant chat disabled.

# Google Gemini API key — powers recipe embeddings + smart search + the chat assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
