{
  "name": "recipe-finder",
  "version": "1.0.0",
  "description": "Full-stack recipe recommendation platform using Java Spring Boot, React, and Supabase Postgres, deployed on Render and Vercel",
  "license": "MIT",
  "author": {
    "name": "Atharva Devasthali",
    "email": "atharvadevasthali22@gmail.com",
    "url": "https://atharvadevasthali.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1atharvad/recipe-finder.git"
  },
  "homepage": "https://github.com/1atharvad/recipe-finder#readme",
  "bugs": {
    "url": "https://github.com/1atharvad/recipe-finder/issues"
  },
  "keywords": [
    "recipe-finder",
    "java-spring-boot",
    "react",
    "postgresql",
    "supabase",
    "microservices",
    "food-recommendation",
    "ingredient-search"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "dotenv -e .env -- mvn -f backend spring-boot:run",
    "dev:frontend": "wait-on tcp:6754 && npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "mvn -f backend clean package -DskipTests",
    "build:frontend": "npm --prefix frontend run build",
    "start": "dotenv -e .env -- java -jar backend/target/backend-0.0.1-SNAPSHOT.jar",
    "test:backend": "mvn -f backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^7.4.4",
    "wait-on": "^8.0.1"
  }
}
