{
  "name": "recipe-finder",
  "version": "1.0.0",
  "description": "Full-stack recipe recommendation platform using Java Spring Boot, React, PostgreSQL with Docker containerization and Nginx deployment",
  "license": "MIT",
  "author": {
    "name": "Atharva Devasthali",
    "email": "atharvadevasthali22@gmail.com",
    "url": "https://atharvadevasthali.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1atharvad/recipe-finder.git"
  },
  "homepage": "https://github.com/1atharvad/recipe-finder#readme",
  "bugs": {
    "url": "https://github.com/1atharvad/recipe-finder/issues"
  },
  "keywords": [
    "recipe-finder",
    "java-spring-boot",
    "react",
    "postgresql",
    "docker",
    "microservices",
    "food-recommendation",
    "ingredient-search"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "docker compose -f docker-compose.dev.yml up postgres backend",
    "dev:frontend": "wait-on tcp:6754 && npm --prefix frontend run dev",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  }
}